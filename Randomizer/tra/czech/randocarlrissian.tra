// Würfelbecher des Randomizers
@501 = ~1/6: 	      V tomto pokusu jsi hodil 1. Na základě hodu společníků
              si můžeš přibližně odhadnout, kolik společníků potkáš, a
              podle toho přizpůsobit svůj herní styl. V některých případech může
              proces náhodného výběru trvat poměrně dlouho. Prosím, počkej
              tak dlouho. Dodatečná změna tvého výsledku není možná!
              Nyní stiskni klávesu ENTER, abys spustil proces generování náhodných výsledků.~
@502 = ~2/6: 	      V tomto průchodu jsi hodil 2. Na základě hodu na společníky
