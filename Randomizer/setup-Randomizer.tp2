COMPONENTINFO ~ ATTENTION: This is less a mod, but more an additional die/game            ~
COMPONENTINFO ~            component! It must ALWAYS be installed as the  last            ~
COMPONENTINFO ~            mod and may only be executed once, because it  sets    		  ~
COMPONENTINFO ~            the world state! Read the Readme!               								  ~
COMPONENTINFO ~ ------------------------------------------------------------------------- ~

// LANGUAGE Definition Start
// -------------------
AUTO_TRA ~Randomizer/tra/autotra/%s~

ALWAYS 
	ACTION_IF 	    GAME_IS ~eet~ 			OR 	
					GAME_IS ~bg1~ 			OR 
					GAME_IS ~bg2~ 			OR
					GAME_IS ~tob~ 			OR
					GAME_IS ~soa~ 			OR
					GAME_IS ~tutu~ 			OR
					GAME_IS ~tutu_totsc~ 	OR 
					GAME_IS ~iwd1~ 			OR 
					GAME_IS ~iwdee~ 		OR 
					GAME_IS ~pst~ 			OR 
					GAME_IS ~pstee~ 		OR 
					GAME_IS ~iwd2~ 			OR 
					GAME_IS ~iwd_in_bg2~ 	OR 
					GAME_IS ~ca~ 			OR 
					GAME_IS ~totlm~ 		OR
					GAME_IS ~how~             	 					
	BEGIN 
		 			FAIL  @101
	END
	
	ACTION_IF 	    MOD_IS_INSTALLED ~mercenaries/Setup-Mercenaries.tp2~ 0 
	BEGIN 
		 			FAIL  @106				
	END 
END
	
LANGUAGE ~English~
         ~english~
         ~Randomizer/tra/english/setup.tra~
		 ~Randomizer/tra/english/dialog.tra~
		 ~Randomizer/tra/english/randocarlrissian.tra~

