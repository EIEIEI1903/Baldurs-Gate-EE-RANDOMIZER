/*	
	--------------------------
	----------Main----------
	--------------------------
*/
	BEGIN @200 //strt BCR
		SUBCOMPONENT @100
			INCLUDE ~Randomizer/lib/flamingoMagic.tpa~
			ACTION_IF GAME_IS ~bgee~ THEN BEGIN  		//temporary essential for v.0.1.0 - later removed
				LAF basicCast END
			END
	BEGIN @300 //strt ACR
		SUBCOMPONENT @100 
			INCLUDE ~Randomizer/lib/turtleMagic.tpa~
			ACTION_IF GAME_IS ~bgee~ THEN BEGIN 		//temporary essential for v.0.1.0 - later removed
				LAF Advanced_Cast_Gatekeeper END
			END
	BEGIN @400 //strt OMCR
		SUBCOMPONENT @100
			INCLUDE ~Randomizer/lib/MainCastRemoveTool.tpa~
			ACTION_IF GAME_IS ~bgee~ THEN BEGIN 		//temporary essential for v.0.1.0 - later removed
				LAF MainCastRemoveTool END
			END