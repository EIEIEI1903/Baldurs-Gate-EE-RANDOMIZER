	END
	
/*
		___________________________
		|		Gatekeeper	      |
		|Hier startet die Funktion|
		|(Prüfung der min. Mods	  |
		|_________________________|
*/
DEFINE_ACTION_FUNCTION Advanced_Cast_Gatekeeper
	
	INT_VAR
	minNPC_Mod_Zahl = 3
	localCheck = 0
	localCount = 0
	
	BEGIN
	INCLUDE ~Randomizer/lib/GrafzahlHelper.tpa~
/*	
	--------------------------
	Prüfung der installierten Mindestmods
	--------------------------
*/				
		LAF CountCount
			RET localCheck = varModCheck localCount = varModCount
		END
		
		OUTER_SET localCheck = minNPC_Mod_Zahl
		ACTION_IF localCount >= localCheck BEGIN
						LAF Advanced_Cast END 
		END ELSE BEGIN 
					FAIL  @105
				 END				 
	END
	