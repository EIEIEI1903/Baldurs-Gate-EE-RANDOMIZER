		END
		
		OUTER_SET next_indexM = 0 
		ACTION_PHP_EACH personenteilnahmeregisterB38 AS index => value BEGIN		
			ACTION_IF "%value%" STR_EQ ~Ajantis~ 									OR
					  "%value%" STR_EQ ~Alora~ 										OR
                      "%value%" STR_EQ ~Baeloth~ 									OR
                      "%value%" STR_EQ ~Branwen~ 									OR
                      "%value%" STR_EQ ~Coran~ 										OR
                      "%value%" STR_EQ ~DornIlKhan~ 								OR
                      "%value%" STR_EQ ~Faldorn~ 									OR
                      "%value%" STR_EQ ~Garrick~ 									OR
                      "%value%" STR_EQ ~Kivan~ 										OR
                      "%value%" STR_EQ ~Minsc-Dynaheir-Edwin~ 						OR
                      "%value%" STR_EQ ~Neera~ 										OR
                      "%value%" STR_EQ ~Quayle~ 									OR
                      "%value%" STR_EQ ~Rasaad~ 									OR
                      "%value%" STR_EQ ~Safana~ 									OR
                      "%value%" STR_EQ ~Shar-Teel~ 									OR
                      "%value%" STR_EQ ~Tiax~ 										OR
                      "%value%" STR_EQ ~Viconia~ 									OR
                      "%value%" STR_EQ ~Xar-Montaron~ 								OR
                      "%value%" STR_EQ ~Yeslick~ 									OR
					  "%value%" STR_EQ ~~ 											OR
                      "%value%" STR_EQ ~DABEI~ 										BEGIN	
// 								programieren wie ein Otto, wegen DeMorgan ):-/
					END ELSE 														BEGIN	
							OUTER_SPRINT $LoeschregisterMod("%next_indexM%") "%value%"					
					END	
