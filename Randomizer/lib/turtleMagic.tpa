//  ------------------------------------
	strS1  = ~PfaugNPC/setup-PfaugNPC.tp2~	// wird bei künftigen Versionen durch Gruppe 4 ersetzt.	
	strS2  = ~MAWGULNPC/SETUP-MAWGULNPC.tp2~ // wird bei künftigen Versionen durch Gruppe 4 ersetzt.	
	strS3  = ~MTSTAIM.tp2~ // wird bei künftigen Versionen durch Gruppe 4 ersetzt.	
	
	RET_ARRAY 
	LoeschregisterBase
	LoeschregisterMod
// ------------------------------------------ 
	BEGIN
		INCLUDE ~Randomizer/lib/D6no7.tpa~
//      ----------------------------------------------------------------------------		
		ACTION_DEFINE_ARRAY personenteilnahmeregisterB38 BEGIN 
		~Ajantis~
		~Alora~
		~Amros~
		~Areen~
		~Arkanis~
		~Aura~
		~Ayden~
		~Baeloth~
		~Brandock~
