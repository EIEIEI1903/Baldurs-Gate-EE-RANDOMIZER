		~Viconia~
		~Vicril~
		~Vienxay~
		~WALAHNAN~
		~white~
		~Xan~
		~Xar-Montaron~
		~Yeslick~
		~Zakrion~
		~Zarra~
		~Z-KIT-Alarin~
		~Z-Sonstige~
		END
		ACTION_DEFINE_ARRAY LoeschregisterMod BEGIN END
		ACTION_DEFINE_ARRAY LoeschregisterBase BEGIN END
/*
		KEEP IN MIND --- Never-list:
					- Brage (Gruppe2)
					- Corwin/Argent from LCA (BG1EE parts)
					- Skie Cost of one Girl's soul (Gruppe1)
					- Anything from Blackheats (likely very involved)
					- Aerie in BG1 (discussable for later version of Randomizer)
					- Will of the Wisps (not a real companion)
*/
		LAF D6Komma9x
			RET BegleiterWuerfel = D6Komma9xResult
		END
//--------------------------------------------------------------------------------
//				Würfelfeedback
//--------------------------------------------------------------------------------
		ACTION_IF (BegleiterWuerfel <= 9) BEGIN
			PRINT @501
		END ELSE BEGIN
					ACTION_IF (BegleiterWuerfel == 10) BEGIN
						PRINT @502
					END ELSE BEGIN
								ACTION_IF (BegleiterWuerfel == 11) BEGIN
									PRINT @503
								END ELSE BEGIN
										 	ACTION_IF (BegleiterWuerfel == 12) BEGIN
												PRINT @504
											END ELSE BEGIN
													 	ACTION_IF (BegleiterWuerfel == 13) BEGIN
															PRINT @505
														END ELSE BEGIN
																	ACTION_IF (BegleiterWuerfel == 14) BEGIN
																		PRINT @506
																	END ELSE BEGIN
																				ACTION_IF (BegleiterWuerfel >= 15) BEGIN
																					PRINT @507
																				END 
																			 END
																 END
													 END
										 END
							 END
				 END

		ACTION_READLN ~scanfENTER~
		SILENT
//--------------------------------------------------------------------------------		
		OUTER_FOR (; num < BegleiterWuerfel; ++num) BEGIN
			
			RANDOM_SEED ~NEUER_SEED~
        	OUTER_SET var_zwischen = RANDOM (1 72)
			OUTER_SET blog=0
			OUTER_FOR (a=1; a <= 72; ++a) BEGIN
				ACTION_IF var_zwischen = a THEN BEGIN
					OUTER_SPRINT $ EVAL personenteilnahmeregisterB38(~%blog%~) ~DABEI~
				END
				OUTER_SET ++blog
			END
		END
//--------------------------------------------------------------------------------
		INCLUDE ~Randomizer/lib/deterministisch.tpa~
//--------------------------------------------------------------------------------
//							Zusweisung
//--------------------------------------------------------------------------------
// 		Note: Loop possible, but not desired! 

		OUTER_SPRINT var_namest $personenteilnahmeregisterB38(2)	
		ACTION_IF NOT(~%var_namest%~ STR_EQ ~Amros~) 									AND
				 !MOD_IS_INSTALLED ~%str02%~ ~0~ 										BEGIN
					LAF Det_Branwen RET_ARRAY personenteilnahmeregisterB38 				END 
		END

		OUTER_SPRINT var_namest $personenteilnahmeregisterB38(3)	
		ACTION_IF NOT(~%var_namest%~ STR_EQ ~Areen~) 									AND
				 !MOD_IS_INSTALLED ~%str03%~ ~0~ 										BEGIN
					LAF Det_Branwen RET_ARRAY personenteilnahmeregisterB38 				END
