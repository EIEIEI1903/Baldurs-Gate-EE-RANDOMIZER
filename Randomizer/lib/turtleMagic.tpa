	str25  = ~c#greythedog/Setup-c#greythedog.tp2~
    str26  = ~HAIASS/SETUP-HAIASS.tp2~	
	str27  = ~HELGA/SETUP-HELGA.tp2~ 
	str28  = ~JKLHEL/HELARINE_BGEE.tp2~ 
