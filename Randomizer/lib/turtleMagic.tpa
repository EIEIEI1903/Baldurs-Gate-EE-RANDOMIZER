		OUTER_SPRINT var_namest $personenteilnahmeregisterB38(64)			
		ACTION_IF NOT(~%var_namest%~ STR_EQ ~white~) 									AND
				 !MOD_IS_INSTALLED ~%str64%~ ~0~ 										BEGIN
					LAF Det_XAN RET_ARRAY personenteilnahmeregisterB38					END
		END	

		OUTER_SPRINT var_namest $personenteilnahmeregisterB38(68)			
		ACTION_IF NOT(~%var_namest%~ STR_EQ ~Zakrion~) 									AND
				 !MOD_IS_INSTALLED ~%str68%~ ~1000~ 									BEGIN
					OUTER_SPRINT $ EVAL personenteilnahmeregisterB38(~69~) ~DABEI~
		END	

		OUTER_SPRINT var_namest $personenteilnahmeregisterB38(69)			
		ACTION_IF NOT(~%var_namest%~ STR_EQ ~Zarra~) 									AND
				 !MOD_IS_INSTALLED ~%str69%~ ~0~ 										BEGIN
				 	ACTION_IF (BegleiterWuerfel == 13)    	   BEGIN
						OUTER_SPRINT $ EVAL personenteilnahmeregisterB38(~50~) ~DABEI~
						OUTER_SPRINT $ EVAL personenteilnahmeregisterB38(~13~) ~DABEI~
					END ELSE 							  	   BEGIN
						ACTION_IF (BegleiterWuerfel > 13)      BEGIN
						OUTER_SPRINT $ EVAL personenteilnahmeregisterB38(~16~) ~DrizztDoSalva~
						OUTER_SPRINT $ EVAL personenteilnahmeregisterB38(~6~) ~Ayden~
						END ELSE							   BEGIN
															   END
