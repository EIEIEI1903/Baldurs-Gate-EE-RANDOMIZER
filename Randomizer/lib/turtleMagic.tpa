		ACTION_IF NOT(~%var_namest%~ STR_EQ ~WALAHNAN~) 								AND
				 !MOD_IS_INSTALLED ~%str63%~ ~0~ 										BEGIN
					LAF Det_XAN RET_ARRAY personenteilnahmeregisterB38					END
