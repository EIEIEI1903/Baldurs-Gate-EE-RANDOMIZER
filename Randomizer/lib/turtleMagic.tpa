					END ELSE 							  	   BEGIN
							ACTION_IF (BegleiterWuerfel == 14) BEGIN
									OUTER_SPRINT $ EVAL personenteilnahmeregisterB38(~18~) ~DABEI~
									OUTER_SPRINT $ EVAL personenteilnahmeregisterB38(~23~) ~DABEI~
									OUTER_SPRINT $ EVAL personenteilnahmeregisterB38(~27~) ~DABEI~
							END ELSE 					  		BEGIN
									OUTER_SPRINT $ EVAL personenteilnahmeregisterB38(~12~) ~DABEI~ 
																END 
																END
		END			

		OUTER_SPRINT var_namest $personenteilnahmeregisterB38(12)	
		ACTION_IF ~%var_namest%~ STR_EQ ~Coran~ 										BEGIN
			// Coran baggert rum xD
			OUTER_SPRINT $ EVAL personenteilnahmeregisterB38(~13~) ~DABEI~		
		END	
		
		OUTER_SPRINT var_namest $personenteilnahmeregisterB38(13)	
		ACTION_IF NOT(~%var_namest%~ STR_EQ ~Desire~) 									AND
