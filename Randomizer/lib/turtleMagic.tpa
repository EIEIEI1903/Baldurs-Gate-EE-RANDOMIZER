		END	
// 									   -Verteilung-
		OUTER_SET next_indexB = 0
		ACTION_PHP_EACH personenteilnahmeregisterB38 AS index => value BEGIN
				
			
			ACTION_IF "%value%" STR_EQ ~Ajantis~ 										BEGIN
				OUTER_SPRINT $LoeschregisterBase("%next_indexB%") "Ajantis"
			END 		
			ACTION_IF "%value%" STR_EQ ~Alora~ 											BEGIN
