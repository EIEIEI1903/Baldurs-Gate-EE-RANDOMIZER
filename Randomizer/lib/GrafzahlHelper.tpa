DEFINE_ACTION_FUNCTION CountCount	
	
	INT_VAR
	varModCount = 0
	varModCheck = 0
    //Returnvalues 
	RET 
		varModCheck
		varModCount
	BEGIN	
		
		ACTION_IF MOD_IS_INSTALLED ~DRIZZTSAGA/drizztsaga.tp2~ 				~0~ BEGIN OUTER_SET varModCount += 1 END
		ACTION_IF MOD_IS_INSTALLED ~SHUKBG1EE/Setup-SHUKBG1EE.tp2~ 			~0~ BEGIN OUTER_SET varModCount += 1 END
		ACTION_IF MOD_IS_INSTALLED ~JKLHEL/HELARINE_BGEE.tp2~ 				~0~ BEGIN OUTER_SET varModCount += 1 END
		ACTION_IF MOD_IS_INSTALLED ~Ishlilkamod/Ishlilkamod-setup.tp2~ 		~0~ BEGIN OUTER_SET varModCount += 1 END
		ACTION_IF MOD_IS_INSTALLED ~7c-gallileo-master/7c-galileo.tp2~  	~0~ BEGIN OUTER_SET varModCount += 1 END
		ACTION_IF MOD_IS_INSTALLED ~C#Brandock/C#Brandock.tp2~ 				~0~ BEGIN OUTER_SET varModCount += 1 END
		ACTION_IF MOD_IS_INSTALLED ~K4MORGUL/setup-k4morgul.tp2~ 			~0~ BEGIN OUTER_SET varModCount += 1 END
		ACTION_IF MOD_IS_INSTALLED ~VERRSZA/VERRSZA.tp2~ 					~0~ BEGIN OUTER_SET varModCount += 1 END
		ACTION_IF MOD_IS_INSTALLED ~MUR'NETH/MUR'NETH.tp2~ 					~0~ BEGIN OUTER_SET varModCount += 1 END
		ACTION_IF MOD_IS_INSTALLED ~VIENXAY/VIENXAY.tp2~ 					~0~ BEGIN OUTER_SET varModCount += 1 END
		ACTION_IF MOD_IS_INSTALLED ~SETUP-TENYATHERMIDOR.tp2~ 				~0~ BEGIN OUTER_SET varModCount += 1 END
		ACTION_IF MOD_IS_INSTALLED ~HELGA/SETUP-HELGA.tp2~  				~0~ BEGIN OUTER_SET varModCount += 1 END
		ACTION_IF MOD_IS_INSTALLED ~KALE/KALE.tp2~ 							~0~ BEGIN OUTER_SET varModCount += 1 END
		ACTION_IF MOD_IS_INSTALLED ~WALAHNAN/WALAHNAN.tp2~ 					~0~ BEGIN OUTER_SET varModCount += 1 END
		ACTION_IF MOD_IS_INSTALLED ~white/white.tp2~ 						~0~ BEGIN OUTER_SET varModCount += 1 END
		ACTION_IF MOD_IS_INSTALLED ~c#greythedog/Setup-c#greythedog.tp2~ 	~0~ BEGIN OUTER_SET varModCount += 1 END
		ACTION_IF MOD_IS_INSTALLED ~INSTALL/Setup-INSTALL.tp2~ 				~0~ BEGIN OUTER_SET varModCount += 1 END
		ACTION_IF MOD_IS_INSTALLED ~Zakrion_BG1/Zakrion_BG1.tp2~ 		 ~1000~ BEGIN OUTER_SET varModCount += 1 END
		ACTION_IF MOD_IS_INSTALLED ~OphysiaBG1/OphysiaBG1.tp2~ 				~0~ BEGIN OUTER_SET varModCount += 1 END
		ACTION_IF MOD_IS_INSTALLED ~PETSY/PETSY.tp2~ 						~0~ BEGIN OUTER_SET varModCount += 1 END
		ACTION_IF MOD_IS_INSTALLED ~RECORDER/SETUP-RECORDER.tp2~ 			~0~ BEGIN OUTER_SET varModCount += 1 END
		ACTION_IF MOD_IS_INSTALLED ~GAVIN/GAVIN.tp2~ 						~0~ BEGIN OUTER_SET varModCount += 1 END
		ACTION_IF MOD_IS_INSTALLED ~FINCHNPC/FINCHNPC.tp2~ 					~0~ BEGIN OUTER_SET varModCount += 1 END
		ACTION_IF MOD_IS_INSTALLED ~EMILY/EMILY.tp2~ 						~0~ BEGIN OUTER_SET varModCount += 1 END
		ACTION_IF MOD_IS_INSTALLED ~DRAKE/SETUP-DRAKE.tp2~ 					~0~ BEGIN OUTER_SET varModCount += 1 END
		ACTION_IF MOD_IS_INSTALLED ~VALERIE/VALERIE.tp2~ 					~0~ BEGIN OUTER_SET varModCount += 1 END
		ACTION_IF MOD_IS_INSTALLED ~SIRENE/SETUP-SIRENE.tp2~				~0~ BEGIN OUTER_SET varModCount += 1 END
		ACTION_IF MOD_IS_INSTALLED ~ISRA/ISRA.tp2~ 							~0~ BEGIN OUTER_SET varModCount += 1 END
		ACTION_IF MOD_IS_INSTALLED ~ACBRE/ACBRE.tp2~ 						~0~ BEGIN OUTER_SET varModCount += 1 END
		ACTION_IF MOD_IS_INSTALLED ~GLAMNPCPACK/SETUP-GLAMNPCPACK.tp2~ 		~0~ BEGIN OUTER_SET varModCount += 1 END
		ACTION_IF MOD_IS_INSTALLED ~AURA_BG1/SETUP-AURA_BG1.tp2~ 			~0~ OR
				  MOD_IS_INSTALLED ~AURA_BG1/SETUP-AURA_BG1_2.tp2~ 			~0~ OR
				  MOD_IS_INSTALLED ~AURA_BG1/SETUP-AURA_BG1_2_EET.tp2~		~0~ BEGIN OUTER_SET varModCount += 1 END
		ACTION_IF MOD_IS_INSTALLED ~AYDEN/SETUP-AYDEN.tp2~ 					~0~ BEGIN OUTER_SET varModCount += 1 END
		ACTION_IF MOD_IS_INSTALLED ~MHORAM/MHORAM.tp2~  					~0~ BEGIN OUTER_SET varModCount += 1 END
		ACTION_IF MOD_IS_INSTALLED ~AREENWILDMAGE/AREENWILDMAGE.tp2~		~0~ BEGIN OUTER_SET varModCount += 1 END
		ACTION_IF MOD_IS_INSTALLED ~ARKANISSOD/ARKANISSOD.tp2~ 				~0~ BEGIN OUTER_SET varModCount += 1 END
		ACTION_IF MOD_IS_INSTALLED ~AMROSNPC/SETUP-AMROSNPC.tp2~ 			~0~ BEGIN OUTER_SET varModCount += 1 END
		ACTION_IF MOD_IS_INSTALLED ~DESIRE/SETUP-DESIRE.tp2~ 				~0~ BEGIN OUTER_SET varModCount += 1 END
		ACTION_IF MOD_IS_INSTALLED ~SETUP-ELLYRIAN.tp2~ 					~0~ OR
				  MOD_IS_INSTALLED ~Ellyrian/SETUP-ELLYRIAN.tp2~			~0~	BEGIN OUTER_SET varModCount += 1 END
		ACTION_IF MOD_IS_INSTALLED ~HAIASS/SETUP-HAIASS.tp2~ 				~0~ BEGIN OUTER_SET varModCount += 1 END
		ACTION_IF MOD_IS_INSTALLED ~C#HUSAM/C#HUSAM.tp2~	 				~0~ BEGIN OUTER_SET varModCount += 1 END
		ACTION_IF MOD_IS_INSTALLED ~KORAX_NPC/KORAX_NPC.tp2~ 				~0~ BEGIN OUTER_SET varModCount += 1 END
		ACTION_IF MOD_IS_INSTALLED ~KVEL_BG1/SETUP-KVEL_BG1.tp2~ 			~0~ BEGIN OUTER_SET varModCount += 1 END
		ACTION_IF MOD_IS_INSTALLED ~MARGARITA/MARGARITA.tp2~ 				~0~ BEGIN OUTER_SET varModCount += 1 END
		ACTION_IF MOD_IS_INSTALLED ~EET_SWO/EET_SWO.tp2~ 					~0~ BEGIN OUTER_SET varModCount += 1 END
		ACTION_IF MOD_IS_INSTALLED ~SETUP-MYMOD.tp2~ 						~0~	OR
				  MOD_IS_INSTALLED ~UzilNPC/SETUP-MYMOD.tp2~				~0~ BEGIN OUTER_SET varModCount += 1 END
		ACTION_IF MOD_IS_INSTALLED ~SETUP-VICRIL.tp2~ 						~0~ OR
				  MOD_IS_INSTALLED ~Vicril/SETUP-VICRIL.tp2~ 				~0~	BEGIN OUTER_SET varModCount += 1 END
		ACTION_IF MOD_IS_INSTALLED ~ZKWSALARIN/SETUP-ZKWSALARIN.tp2~ 		~0~ BEGIN OUTER_SET varModCount += 1 END
		ACTION_IF MOD_IS_INSTALLED ~ACBRE/ACBRE.tp2~				 		~0~ BEGIN OUTER_SET varModCount += 1 END
		ACTION_IF MOD_IS_INSTALLED ~BRISTLELICK/BRISTLELICK.tp2~	 		~0~ BEGIN OUTER_SET varModCount += 1 END
		ACTION_IF MOD_IS_INSTALLED ~INDINPC/SETUP-INDINPC.tp2~				~0~ BEGIN OUTER_SET varModCount += 1 END
		ACTION_IF MOD_IS_INSTALLED ~MotherSoD/MotherSoD.tp2~		 		~0~ BEGIN OUTER_SET varModCount += 1 END
		ACTION_IF MOD_IS_INSTALLED ~SHUKBG1EE/Setup-SHUKBG1EE.tp2~	 		~0~ BEGIN OUTER_SET varModCount += 1 END
// Sonstige-Truppe----------------------------------------------------------------------------------------------------------------
		ACTION_IF MOD_IS_INSTALLED ~PfaugNPC/setup-PfaugNPC.tp2~ 			~0~ OR
				  MOD_IS_INSTALLED ~setup-PfaugNPC.tp2~						~0~	BEGIN OUTER_SET varModCount += 1 END
		ACTION_IF MOD_IS_INSTALLED ~MAWGULNPC/SETUP-MAWGULNPC.tp2~ 			~0~ BEGIN OUTER_SET varModCount += 1 END
		ACTION_IF MOD_IS_INSTALLED ~MTSTaim/MTSTAIM.tp2~ 					~0~ BEGIN OUTER_SET varModCount += 1 END
/*		
		ACTION_IF MOD_IS_INSTALLED ~Isaac/Setup-Isaac.tp2~ 					~0~ OR 
				  MOD_IS_INSTALLED ~Isaac/Isaac.tp2~ 						~0~ BEGIN OUTER_SET varModCount += 1 END
*/

	END