DEFINE_ACTION_FUNCTION DELETE_Yeslick

    BEGIN

		ACTION_IF ((FILE_EXISTS ~dlc/sod-dlc.zip~) OR (FILE_EXISTS ~sod-dlc.zip~)) THEN BEGIN
				PRINT @102 
		END ELSE BEGIN
				SILENT    
				COPY_EXISTING ~BALDUR.GAM~ ~override~
					LAUNCH_PATCH_FUNCTION DELETE_GAM_NPC
						STR_VAR
							npc_resref = ~YESLIC~
						END
				BUT_ONLY
//-----------------------------------------------------------------------------------------				
//----------Dialogpatcher starten
//-----------------------------------------------------------------------------------------	
					
					PRINT @103
					SILENT

					<<<<<<<< .../RANDOMIZER-inlined/minec2.d
						REPLACE_SAY ~MINEC2~ 5 @0
					>>>>>>>>
					COMPILE ~.../RANDOMIZER-inlined/minec2.d~
				
//-----------------------------------------------------------------------------------------		
				 END	 	
    
	END	
DEFINE_ACTION_FUNCTION DELETE_BEAM_Neera

    BEGIN
		ACTION_IF MOD_IS_INSTALLED ~EE_CONTENT_TWEAKS\EE_CONTENT_TWEAKS.TP2~ ~1~ OR 
				  MOD_IS_INSTALLED ~EE_CONTENT_TWEAKS\EE_CONTENT_TWEAKS.TP2~ ~2~ BEGIN		
		END ELSE BEGIN
// 		if peccas content tweaks are installed, the standard deletion routine of Randomizer won't trigger.
			LAUNCH_ACTION_FUNCTION DELETE_NEERA_BG1 END  
				 END		 
	END
DEFINE_ACTION_FUNCTION DELETE_BEAM_Dorn

    BEGIN
		ACTION_IF MOD_IS_INSTALLED ~EE_CONTENT_TWEAKS\EE_CONTENT_TWEAKS.TP2~ ~5~ BEGIN
// 		if peccas content tweaks are installed, the standard deletion routine of Randomizer won't trigger.		
		END ELSE BEGIN
			LAUNCH_ACTION_FUNCTION DELETE_DORN END 
				 END	        	 
	END
