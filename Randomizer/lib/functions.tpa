DEFINE_ACTION_FUNCTION DELETE_Ajantis

    BEGIN
        COPY_EXISTING ~BALDUR.GAM~ ~override~
			LAUNCH_PATCH_FUNCTION DELETE_GAM_NPC
        		STR_VAR
            	npc_resref = ~AJANTI~
			END
		BUT_ONLY
 
    END
