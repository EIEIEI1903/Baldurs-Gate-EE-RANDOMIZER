DEFINE_ACTION_FUNCTION Det_Branwen
// ------------------------------------------
// Funktionskopf
// ------------------------------------------
	RET_ARRAY personenteilnahmeregisterB38
// ------------------------------------------
BEGIN
	ACTION_IF MOD_IS_INSTALLED ~%str30%~ ~0~ BEGIN
		OUTER_SPRINT $ EVAL personenteilnahmeregisterB38(~30~) ~DABEI~
	END ELSE BEGIN
				ACTION_IF MOD_IS_INSTALLED ~%str26%~ ~0~ BEGIN
					OUTER_SPRINT $ EVAL personenteilnahmeregisterB38(~26~) ~DABEI~
				END ELSE BEGIN
							ACTION_IF MOD_IS_INSTALLED ~%str20%~ ~0~ BEGIN
								OUTER_SPRINT $ EVAL personenteilnahmeregisterB38(~20~) ~DABEI~
							END ELSE BEGIN
										ACTION_IF MOD_IS_INSTALLED ~%str17%~ ~0~ BEGIN
											OUTER_SPRINT $ EVAL personenteilnahmeregisterB38(~17~) ~DABEI~
										END ELSE BEGIN
													ACTION_IF MOD_IS_INSTALLED ~%str13%~ ~0~ BEGIN
														OUTER_SPRINT $ EVAL personenteilnahmeregisterB38(~13~) ~DABEI~
													END ELSE BEGIN
																OUTER_SPRINT $ EVAL personenteilnahmeregisterB38(~9~) ~DABEI~
															 END
												 END
									 END
						 END
			 END

END								
