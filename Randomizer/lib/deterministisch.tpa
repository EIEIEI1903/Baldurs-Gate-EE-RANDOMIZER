/* 
   Det_LAST_Pfaug Start:
   
   In dieser besonderen Kette befinden sich nur 
   Companions die nicht üblicherweise zu EE Version
   gehören oder nicht mehr verfügbar sind.
   
   Für den seltenen Fall, dass diese Gruppe gewürfelt
   wird und nicht vorhanden ist, also durchläuft, wird
   bei einem trefferlosen Durchgang der das Feld als -1
   zur aktuellen Gruppe ausgewertet und entfällt.

   Diese Gruppe wird in späteren versionen einmal 
   durch Figuren der Gruppe 4 ergänzt.
*/
DEFINE_ACTION_FUNCTION Det_LAST_Pfaug
//		Letzte Gruppe 
//		
// ------------------------------------------
// Funktionskopf
// ------------------------------------------
	RET_ARRAY personenteilnahmeregisterB38
// ------------------------------------------
BEGIN

	ACTION_IF MOD_IS_INSTALLED ~%strS1%~ ~0~ BEGIN
		OUTER_SPRINT $ EVAL personenteilnahmeregisterB38(~12~) ~DABEI~
	END ELSE BEGIN
				ACTION_IF MOD_IS_INSTALLED ~%strS2%~ ~0~ BEGIN
					OUTER_SPRINT $ EVAL personenteilnahmeregisterB38(~50~) ~DABEI~
				END ELSE BEGIN
							ACTION_IF MOD_IS_INSTALLED ~%strS3%~ ~0~ BEGIN
								OUTER_SPRINT $ EVAL personenteilnahmeregisterB38(~9~) ~DABEI~
							END ELSE BEGIN
											//  -> LEER~									
									 END
						 END							
			 END 
END
// Det_LAST_Pfaug - Ende!
// ----------------------